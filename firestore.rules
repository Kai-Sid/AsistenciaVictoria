rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // El navegador no lee ni escribe employees, attendances, pinAttempts ni accounts.
    // La marcación y el panel usan el backend de Render con Firebase Admin SDK.
    // Hasta publicar este archivo, en la nube siguen vigentes las reglas anteriores:
    // un administrador autenticado podía leer y escribir attendances desde el cliente.
    match /employees/{employeeId} {
      allow read, write: if false;
    }
    match /attendances/{attendanceId} {
      allow read, write: if false;
    }
    match /pinAttempts/{attemptId} {
      allow read, write: if false;
    }
    match /accounts/{accountId} {
      allow read, write: if false;
    }
    match /weeklyPayments/{paymentId} {
      allow read, write: if false;
    }
  }
}
